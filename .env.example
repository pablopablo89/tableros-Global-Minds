# Copiar a .env.local (dev) y configurar en Vercel (Project Settings → Environment Variables).

# --- Modo de datos ---
# 'snapshot' (default): lee /public/snapshots/<cuenta>.json (agregado real, rápido).
# 'live': la app pega a /api/nods que agrega en vivo desde la API de NODS.
VITE_DATA_MODE=snapshot

# --- Acceso al tablero (pantalla de contraseña) ---
# Clave que valida la pantalla de acceso (modo snapshot, estático). Se embebe en
# el bundle: protege de acceso casual, no es cifrado fuerte.
VITE_APP_PASSWORD=cambia-esta-clave
VITE_REQUIRE_PASSWORD=true
# (Sólo modo live/serverless) misma clave para el proxy /api/nods:
APP_PASSWORD=cambia-esta-clave

# --- API de NODS (sólo para modo 'live' / serverless) ---
# URL base real de la API (sin barra final). Ej: https://api.nods.xxx
NODS_API_BASE=
# Autenticación (elegí una según el esquema de NODS):
NODS_API_TOKEN=
NODS_API_KEY=
